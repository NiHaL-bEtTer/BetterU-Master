{
  "name": "betteru-web",
  "private": true,
  "version": "3.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "typecheck": "tsc -b",
    "lint": "oxlint src",
    "preview": "vite preview",
    "gen:api": "cd ../api && .venv/bin/python -m betteru.export_openapi ../web/src/api/openapi.json && cd ../web && openapi-typescript src/api/openapi.json -o src/api/schema.d.ts"
  },
  "dependencies": {
    "@hugeicons/core-free-icons": "^4.4.0",
    "@hugeicons/react": "^1.1.10",
    "@tailwindcss/vite": "^4.3.5",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cn": "^0.5.2",
    "dompurify": "^3.4.18",
    "gsap": "^3.15.1",
    "lucide-react": "^1.77.0",
    "marked": "^18.2.1",
    "motion": "^14.14.0",
    "openapi-fetch": "^0.17.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "recharts": "^2.15.4",
    "tailwind-merge": "^3.7.1",
    "tailwindcss": "^4.3.5",
    "tw-animate-css": "^1.4.0"
  },
  "devDependencies": {
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.90.0",
    "typescript": "~5.9",
    "vite": "^8.3.6",
    "vite-plugin-pwa": "^2.0.0"
  }
}
