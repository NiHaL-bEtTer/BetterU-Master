# Copy to .env and fill in. Only DATABASE_URL, JWT_SECRET and LLM_API_KEY are required;
# every other key switches on an optional feature.

ENVIRONMENT=development            # development | staging | production

# ── Required ──────────────────────────────────────────────────────────────
# Local: `docker compose up db` starts Postgres with pgvector on this URL.
DATABASE_URL=postgresql+psycopg://betteru:betteru@localhost:5432/betteru
# Signs login sessions. Generate one: python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me
# Any OpenAI-compatible provider. Default is Groq (https://console.groq.com/keys).
LLM_API_KEY=
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=openai/gpt-oss-120b
# LLM_FAST_MODEL=openai/gpt-oss-20b
# LLM_REASONING_EFFORT=low          # for reasoning models; leave empty for others
# LLM_DAILY_MESSAGE_LIMIT=200

# ── Optional features ─────────────────────────────────────────────────────
TAVILY_API_KEY=                    # Alden's trusted-domain web search fallback (https://tavily.com)
YOUTUBE_API_KEY=                   # recipe videos in chat (YouTube Data API v3)
USDA_API_KEY=                      # branded/packaged foods on demand (free: https://fdc.nal.usda.gov/api-key-signup)
SENTRY_DSN=                        # error tracking (https://sentry.io)

# ── Production ────────────────────────────────────────────────────────────
# COOKIE_SECURE=true               # required when served over HTTPS
